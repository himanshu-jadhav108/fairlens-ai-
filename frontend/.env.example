# FairLens AI Frontend Environment Configuration

# Backend API URL (Use http://localhost:8000 for dev, or your Render URL for production Vercel deployment)
VITE_API_URL=https://your-backend-service.onrender.com

# Firebase Web App Credentials (for client-side Firebase Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
