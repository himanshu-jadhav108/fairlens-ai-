# FairLens AI Backend Environment Configuration

# Server Port (Render sets this automatically)
PORT=8000

# Frontend URLs for CORS permission
FRONTEND_URL=http://localhost:5173
VERCEL_ORIGIN=https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Google Gemini API Key for Natural Language AI Explanations
# Optional: If omitted, bias analysis will continue normally and AI explanation will return a safe fallback payload.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Service Account JSON (Raw JSON string)
# Paste single-line JSON of your Firebase Admin SDK service account key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
